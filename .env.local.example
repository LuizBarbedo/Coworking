# Copie para .env.local e preencha. Nunca commite o .env.local.

# --- Supabase (Project Settings → API) ---
# Em produção (desde 05/08/2026) aponta pro stack SELF-HOSTED da VPS via
# rota nginx (docs/migracao-banco-vps.md); as chaves saem do .env de
# /opt/coworking-supabase. Num projeto cloud, use os valores do painel.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor — cria contas no 1º acesso, métricas, IA. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres direto (migrações via psql e scripts de backup) ---
# Produção: pooler local (postgresql://postgres.<tenant>:SENHA@127.0.0.1:5433/postgres).
DATABASE_URL=
# Projeto Supabase cloud antigo — SÓ redundância (espelho diário 04:00,
# scripts/redundancia-nuvem.sh). Vazio desliga o espelho.
DATABASE_URL_NUVEM=
SUPABASE_NUVEM_URL=
SUPABASE_NUVEM_SERVICE_KEY=

# --- Domínio e lançamento ---
# URL pública canônica do site (metadataBase das OG images; baked no build).
NEXT_PUBLIC_SITE_URL=https://coworkingsocial.com.br
# Domínio que, antes do lançamento, serve só a landing (rotas da plataforma
# redirecionam pra "/"). Vazio = portão desligado (dev e outros deploys).
DOMINIO_LANDING=
# "sim" libera a plataforma no domínio principal (dia do lançamento; lida em
# runtime — basta reiniciar o serviço, sem rebuild).
PLATAFORMA_LIBERADA=nao

# --- Painel administrativo (/relatorios) ---
# Senha única compartilhada da coordenação (cookie de 12h).
PAINEL_SENHA=

# --- Envio de e-mail ---
# Preferido: SMTP do provedor transacional, com o domínio autenticado
# (SPF + DKIM + DMARC publicados no DNS). Deixe em branco para continuar
# enviando pelo Gmail durante a transição.
SMTP_HOST=
# 587 (STARTTLS) ou 465 (TLS direto). Padrão: 587.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Endereço que aparece como remetente. Sem isso, cai no GMAIL_USER.
EMAIL_REMETENTE=
# Nome de exibição. Padrão: "Coworking Social".
EMAIL_REMETENTE_NOME=
# Para onde vão as respostas. Se vazio e o remetente for do domínio, as
# respostas vão pro GMAIL_USER — o domínio não tem caixa postal (sem MX).
EMAIL_REPLY_TO=

# Retaguarda / transição: Gmail SMTP.
GMAIL_USER=
# Senha de app (https://myaccount.google.com/apppasswords), não a senha da conta.
GMAIL_APP_PASSWORD=

# --- Aviso automático de módulo novo (scripts/avisos-modulos.sh, cron horário) ---
# Corte de ativação (AAAA-MM-DD): módulo que abriu ANTES desta data nunca gera
# aviso. Define-se uma vez, ao ligar o recurso — sem isso a primeira rodada
# anunciaria todo o catálogo que já está no ar. O script se recusa a rodar
# enquanto estiver vazia.
AVISOS_DESDE=
# Intervalo entre envios, em ms (padrão 9000). Vale para todos os disparos.
DISPARO_INTERVALO_MS=

# --- IA de apoio ao aluno (Ollama Cloud) ---
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=https://ollama.com
# "true" liga o modo de raciocínio (modelos que suportam think).
OLLAMA_THINK=false

# --- Narração do tour guiado (offline; só para regerar os áudios) ---
# Usada apenas por scripts/gerar_narracao_elevenlabs.py — não é lida em runtime.
ELEVENLABS_API_KEY=

# --- Vídeo das aulas (Cloudflare R2, só servidor) ---
# Bucket privado; upload via presigned PUT, playback via presigned GET.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_VIDEOS=csmg-videos

# --- Transcodificação na Modal (sob demanda) ---
# URL do web endpoint da Modal (scripts/modal/transcode.py) + segredo que
# autentica o disparo e o callback /api/video/concluir. A Modal recebe só R2 +
# este segredo (nunca a service-role key).
MODAL_TRANSCODE_URL=
VIDEO_WEBHOOK_SECRET=
